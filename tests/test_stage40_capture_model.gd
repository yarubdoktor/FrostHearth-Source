extends SceneTree
## Run with: godot --headless --path . -s res://tests/test_stage40_capture_model.gd
const Arena = preload("res://scripts/competition/competition_arena.gd")
const Capture = preload("res://scripts/competition/competition_capture.gd")

func _initialize() -> void:
	var layout: Dictionary = Arena.create_layout(Arena.MODE_QUALIFIER)
	var state: Dictionary = Capture.create_state(layout, ["p1", "p2", "p3", "p4"])
	assert(not state.is_empty())
	assert(Capture.create_state(layout, ["p1", "p1"]).is_empty())
	assert(Capture.set_presence(state, "missing", "central_keep", 1).is_empty())
	assert(Capture.set_presence(state, "p1", "unknown", 1).is_empty())
	var with_presence: Dictionary = Capture.set_presence(state, "p1", "central_keep", 2)
	with_presence = Capture.advance(with_presence, 5.0)
	var summary: Dictionary = Capture.objective_summary(with_presence, "central_keep")
	assert(is_equal_approx(float(summary.get("progress", 0.0)), 80.0))
	assert(str(summary.get("owner_id", "")) == "")
	with_presence = Capture.advance(with_presence, 2.0)
	summary = Capture.objective_summary(with_presence, "central_keep")
	assert(str(summary.get("owner_id", "")) == "p1")
	assert(is_equal_approx(float(summary.get("progress", 0.0)), 100.0))
	var contested: Dictionary = Capture.set_presence(with_presence, "p2", "central_keep", 2)
	contested = Capture.advance(contested, 3.0)
	summary = Capture.objective_summary(contested, "central_keep")
	assert(str(summary.get("owner_id", "")) == "p1")
	assert(is_equal_approx(float(summary.get("progress", 0.0)), 100.0))
	var counterattack: Dictionary = Capture.set_presence(contested, "p1", "central_keep", 0)
	counterattack = Capture.advance(counterattack, 5.0)
	summary = Capture.objective_summary(counterattack, "central_keep")
	assert(str(summary.get("owner_id", "")) == "p1")
	assert(is_equal_approx(float(summary.get("progress", 0.0)), 20.0))
	assert(int(summary.get("present_units", -1)) == 2)
	assert(int(summary.get("contesting_players", -1)) == 1)
	counterattack = Capture.advance(counterattack, 2.0)
	summary = Capture.objective_summary(counterattack, "central_keep")
	assert(str(summary.get("owner_id", "")) == "")
	assert(is_equal_approx(float(summary.get("progress", 0.0)), 0.0)
	assert(int(summary.get("present_units", -1)) == 2)
	assert(int(summary.get("contesting_players", -1)) == 1)
	assert(not bool(summary.get("authoritative", true)))
	quit(0)
